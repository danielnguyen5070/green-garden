# Backend API base URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8000

# `next build` fails when the API is unreachable, so a deploy never publishes an
# empty sitemap or catalog. Set to 1 only for local builds without a backend.
# ALLOW_BUILD_WITHOUT_API=1

# Vercel Web Analytics (server-only — never expose the token to the client)
# Used by /api/analytics/visits and the storefront footer page-view counter.
# Create a token at https://vercel.com/account/tokens
VERCEL_ACCESS_TOKEN=
VERCEL_PROJECT_ID=
# Required only for team-owned projects
# VERCEL_TEAM_ID=

# Shared secret for the FastAPI catalog-change webhook (POST /api/revalidate).
# Must equal STOREFRONT_REVALIDATE_SECRET in green-garden-api.
# Generate with: openssl rand -hex 32
REVALIDATE_WEBHOOK_SECRET=
