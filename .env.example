# Backend API base URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8000

# `next build` fails when the API is unreachable, so a deploy never publishes an
# empty sitemap or catalog. Set to 1 only for local builds without a backend.
# ALLOW_BUILD_WITHOUT_API=1

# --- Playwright E2E (tests/e2e) ---
# Prefer a dedicated local/test API. Never point these at production.
# E2E_API_URL=http://localhost:8000
# PLAYWRIGHT_BASE_URL=http://localhost:3000
# Optional fixed plant slug; otherwise the suite picks the first orderable plant.
# E2E_PLANT_SLUG=
# Optional category slug for browse/pagination E2E; otherwise the largest category.
# E2E_CATEGORY_SLUG=
# Use a VN mobile that is not an inactive customer in the test DB.
# E2E_CHECKOUT_PHONE=0370000099
# E2E_CHECKOUT_NAME=E2E Test Customer
# E2E_CHECKOUT_ADDRESS=618/34 Ap Binh Tay, Vinh Thanh, Vinh Long
# Required only when E2E_API_URL is a non-local dedicated staging host (not production).
# E2E_ALLOW_REMOTE=1
# Local/test admin for tests/e2e/admin-auth.spec.ts (never commit real secrets).
# E2E_ADMIN_EMAIL=
# E2E_ADMIN_PASSWORD=

# Vercel Web Analytics (server-only — never expose the token to the client)
# Used by /api/analytics/visits and the storefront footer page-view counter.
# Create a token at https://vercel.com/account/tokens
VERCEL_ACCESS_TOKEN=
VERCEL_PROJECT_ID=
# Required only for team-owned projects
# VERCEL_TEAM_ID=

# Shared secret for the FastAPI catalog-change webhook (POST /api/revalidate).
# Must equal STOREFRONT_REVALIDATE_SECRET in green-garden-api.
# Generate with: openssl rand -hex 32
REVALIDATE_WEBHOOK_SECRET=
